# Copy this to .env.local for local development with `vercel dev`,
# or set the same keys in the Vercel project's Environment Variables
# (Project -> Settings -> Environment Variables) for production.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
CLAUDE_MODEL=claude-sonnet-5
